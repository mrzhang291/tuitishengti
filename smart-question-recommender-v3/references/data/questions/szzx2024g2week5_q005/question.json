      "type": "text",
      "text": "先单调递减，再单调递增，则"
    },
    {
      "type": "math",
      "formula_id": "f006",
      "text_approx": "f^'(x)"
    },
    {
      "type": "text",
      "text": "先为负数，再为正数，在当"
    },
    {
      "type": "math",
      "formula_id": "f007",
      "text_approx": "x>0"
    },
    {
      "type": "text",
      "text": "时，"
