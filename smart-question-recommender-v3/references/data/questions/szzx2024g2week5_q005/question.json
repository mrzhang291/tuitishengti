    {
      "type": "math",
      "formula_id": "f008",
      "text_approx": "f(x)"
    },
    {
      "type": "text",
      "text": "先单调递增，再单调递减，最后单调递增，所以"
    },
    {
      "type": "math",
      "formula_id": "f009",
      "text_approx": "f^'(x)"
    },
    {
      "type": "text",
      "text": "先为正数，再为负数，最后为正数，故只有"
