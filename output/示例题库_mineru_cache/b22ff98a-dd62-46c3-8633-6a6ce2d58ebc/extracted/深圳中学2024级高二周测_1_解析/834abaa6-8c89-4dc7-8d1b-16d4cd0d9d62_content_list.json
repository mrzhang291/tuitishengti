            663
        ],
        "page_idx": 1
    },
    {
        "type": "text",
        "text": "且 $f(0) + f(3) = 1$ 即 $f(3) = -1$ ，且 $f(-1) + f(4) = 1$ 即 $f(4) = 1 - f(1)$",
        "bbox": [
